# Example only. Copy to .env.studio.local (ignored). Never commit actual secrets.
STUDIO_ENV=local
STUDIO_LICENSE_ENABLED=false
STUDIO_WEB_ORIGIN=http://localhost:3040
STUDIO_FIREBASE_PROJECT_ID=demo-kokomemory-local
STUDIO_SIGNING_KEY_ID=local-only-key
STUDIO_SIGNING_PRIVATE_KEY=
STUDIO_TRUSTED_PUBLIC_KEYS_JSON={}
# Set only if the hosting proxy overwrites/removes spoofed inbound headers.
STUDIO_TRUSTED_CLIENT_IP_HEADER=
GCLOUD_PROJECT=demo-kokomemory-local
FIREBASE_PROJECT_ID=demo-kokomemory-local
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kokomemory-local
NEXT_PUBLIC_FIREBASE_API_KEY=demo-local-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-kokomemory-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-local-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-kokomemory-local.appspot.com
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
STUDIO_MIGRATION_PROJECT_CONFIRM=
# Staging: use a distinct Firebase project and server-only service credentials or ADC.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Staging R2 only; never reuse production uploads during verification.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
