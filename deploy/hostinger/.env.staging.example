# Template only. Copy to the repository root as .env.staging and restrict its permissions (chmod 600).
# Never commit the real file and never copy it to the VPS over an unreviewed channel.
STUDIO_ENV=staging
# Keep false until the staging migration, signing config, R2 and readiness have all been checked.
STUDIO_LICENSE_ENABLED=false
STUDIO_WEB_ORIGIN=https://studio-staging.kokomemory.com
STUDIO_FIREBASE_PROJECT_ID=
STUDIO_SIGNING_KEY_ID=
STUDIO_SIGNING_PRIVATE_KEY=
STUDIO_TRUSTED_PUBLIC_KEYS_JSON=
# Nginx overwrites X-Real-IP with the real client address (see nginx-https.conf.example).
STUDIO_TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Public host that serves release installers (Cloudflare R2 custom domain on the public bucket).
STUDIO_DOWNLOAD_BASE_URL=https://downloads.kokomemory.com

# Public build-time configuration.
NEXT_PUBLIC_APP_URL=https://studio-staging.kokomemory.com
NEXT_PUBLIC_SITE_URL=https://studio-staging.kokomemory.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_R2_PUBLIC_URL=

# Server-only runtime secrets (staging project only, never production credentials).
GCLOUD_PROJECT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_URL=
